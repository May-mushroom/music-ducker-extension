{
  "manifest_version": 3,
  "name": "Music Ducker",
  "version": "1.0.0",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "tabs",
    "tabCapture",
    "offscreen",
    "storage", 
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidePanel.html"
  }
}