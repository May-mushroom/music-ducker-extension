{
  "manifest_version": 3,
  "name": "Music Ducker",
  "version": "1.0.0",
  "description": "Lowers a pinned YouTube background tab while other YouTube tabs are playing.",
  "permissions": ["tabCapture", "offscreen", "storage", "scripting", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup/popup.html", "default_title": "Music Ducker" }
}